{
  "name": "bun-kafka-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun run --cwd packages/kafka test",
    "lint": "bun run --cwd packages/kafka lint",
    "typecheck": "bun run --cwd packages/kafka typecheck",
    "docs:dev": "bun run --cwd packages/docs dev",
    "docs:build": "bun run --cwd packages/docs build",
    "docs:preview": "bun run --cwd packages/docs preview"
  }
}
