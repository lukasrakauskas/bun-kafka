{
  "name": "bun-kafka",
  "version": "0.2.0",
  "description": "Zero-dependency Kafka wire protocol client for Bun",
  "module": "index.ts",
  "types": "index.ts",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "test": "bun test test/bun-native.test.ts",
    "test:integration": "bun test test/bun-integration.test.ts",
    "test:chaos:mock": "bun test test/chaos.test.ts",
    "test:chaos": "bun scripts/chaos.ts",
    "typecheck": "bunx tsc --noEmit",
    "bench": "bun scripts/bench-bun.ts",
    "bench:build": "bun run scripts/build-benches.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
